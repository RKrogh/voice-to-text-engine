<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <PackageId>VoiceToText.Vosk</PackageId>
    <Description>Vosk speech-to-text provider for VoiceToText</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VoiceToText\VoiceToText.csproj" />
    <!-- Its native library ships as build assets; NuGet drops those from our dependency unless
         PrivateAssets is cleared, and consumers then fail with DllNotFoundException. -->
    <PackageReference Include="Vosk" PrivateAssets="none" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VoiceToText.Tests" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
</Project>
